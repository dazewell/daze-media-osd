<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>DazeMediaOsd</AssemblyName>
    <RootNamespace>DazeMediaOsd.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- FileDescription: the name Task Manager and Startup apps show. -->
    <AssemblyTitle>Daze Media OSD</AssemblyTitle>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged, self-contained Windows App SDK (D-003). -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained Condition="'$(_IsPublishing)' == 'true'">true</SelfContained>
    <!-- Without it publish drops DazeMediaOsd.pri and the .xbf files: the app dies loading XAML (X-004). -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Program.Main picks launcher or app mode before any XAML type is touched (D-006). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- Installer hooks in Program.Main (D-029). -->
    <PackageReference Include="Velopack" />
    <!-- For About: ReleaseInfo throws in a self-contained app and the runtime DLLs only say "2.0". -->
    <AssemblyMetadata Include="WindowsAppSdkVersion"
                      Value="@(PackageVersion->WithMetadataValue('Identity', 'Microsoft.WindowsAppSDK')->'%(Version)')" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\*.ico;Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DazeMediaOsd.Core\DazeMediaOsd.Core.csproj" />
  </ItemGroup>

</Project>
