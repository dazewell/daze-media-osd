<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DazeMediaOsd.App.HotkeyRecorder"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="220">

    <UserControl.Resources>
        <!-- Small borderless button inside a text box, like TextBox's own clear button. -->
        <Style x:Key="HotkeyBoxButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <!-- Records the keys pressed while focused (D-021); reset and turn-off sit inside the box. -->
    <Grid VerticalAlignment="Center">
        <TextBox x:Name="Box" IsReadOnly="True" PlaceholderText="None" Padding="11,5,68,6"
                 PreviewKeyDown="OnKeyDown" PreviewKeyUp="OnKeyUp"
                 GotFocus="OnGotFocus" LostFocus="OnLostFocus" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,4,0" Spacing="2">
            <Button x:Name="ResetButton" Style="{StaticResource HotkeyBoxButton}" Click="OnReset"
                    AutomationProperties.Name="Reset shortcut" Visibility="Collapsed">
                <FontIcon Glyph="&#xE777;" FontSize="12" />
            </Button>
            <Button x:Name="ClearButton" Style="{StaticResource HotkeyBoxButton}" Click="OnClear"
                    AutomationProperties.Name="Clear shortcut"
                    ToolTipService.ToolTip="Clear" Visibility="Collapsed">
                <FontIcon Glyph="&#xE894;" FontSize="12" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
