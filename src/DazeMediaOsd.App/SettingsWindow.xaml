<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DazeMediaOsd.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DazeMediaOsd.App"
    xmlns:viewModels="using:DazeMediaOsd.App.ViewModels"
    Title="Daze Media OSD settings">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <!-- Cards modelled on Windows Settings: icon, header + description, control on the right.
                 Own style instead of the Community Toolkit SettingsCard package (D-010). -->
            <Style x:Key="SettingsCard" TargetType="Grid">
                <Setter Property="MinHeight" Value="68" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="ColumnSpacing" Value="16" />
                <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="SettingsCardIcon" TargetType="FontIcon">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="SettingsCardDescription" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SettingsSection" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="1,24,0,4" />
            </Style>
        </Grid.Resources>

        <TitleBar x:Name="AppTitleBar" Title="Daze Media OSD" Subtitle="Settings" />

        <NavigationView x:Name="Navigation" Grid.Row="1"
                        PaneDisplayMode="Left" IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False" OpenPaneLength="200"
                        SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="OsdItem" Content="Pop-up" Tag="Osd" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE767;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Shortcuts" Tag="Shortcuts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE765;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Mouse wheel" Tag="Wheel">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE962;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="About" Tag="About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <ScrollViewer>
                <Grid Padding="36,8,36,36" MaxWidth="1000" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Above the pages: any page's edit can fail to save. -->
                    <InfoBar Margin="0,0,0,8" Severity="Error" Title="Couldn't save your settings" IsClosable="False"
                             IsOpen="{x:Bind ViewModel.HasSaveError, Mode=OneWay}"
                             Message="{x:Bind ViewModel.SaveError, Mode=OneWay}">
                        <InfoBar.Content>
                            <TextBlock Text="Your changes will work until you quit the app." Margin="0,0,0,12"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </InfoBar.Content>
                    </InfoBar>

                    <StackPanel x:Name="OsdPage" Grid.Row="1" Spacing="4">
                        <TextBlock Text="Pop-up" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />

                        <TextBlock Text="Appearance" Style="{StaticResource SettingsSection}" />
                        <Grid Style="{StaticResource SettingsCard}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7F4;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Position" />
                                <TextBlock Text="Where the pop-up shows on your main display" Style="{StaticResource SettingsCardDescription}" />
                            </StackPanel>
                            <!-- Item order = SettingsViewModel.PositionOrder (screen order). -->
                            <ComboBox Grid.Column="2" MinWidth="160" VerticalAlignment="Center"
                                      AutomationProperties.Name="Position"
                                      SelectedIndex="{x:Bind ViewModel.PositionIndex, Mode=TwoWay}">
                                <x:String>Top left</x:String>
                                <x:String>Top center</x:String>
                                <x:String>Top right</x:String>
                                <x:String>Bottom left</x:String>
                                <x:String>Bottom center (default)</x:String>
                                <x:String>Bottom right</x:String>
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource SettingsCard}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE916;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Hide after" />
                                <TextBlock Text="Seconds it stays after your last change. Windows uses 2.5." Style="{StaticResource SettingsCardDescription}" />
                            </StackPanel>
                            <NumberBox x:Name="HideAfterBox" Grid.Column="2" MinWidth="160" VerticalAlignment="Center"
                                       AutomationProperties.Name="Hide after (seconds)"
                                       SpinButtonPlacementMode="Inline" SmallChange="0.5" LargeChange="1"
                                       Value="{x:Bind ViewModel.HideAfterSeconds, Mode=TwoWay}" />
                        </Grid>

                        <TextBlock Text="What to show" Style="{StaticResource SettingsSection}" />
                        <Grid Style="{StaticResource SettingsCard}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE720;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Microphone" />
                                <TextBlock Text="Show your microphone and whether it's muted" Style="{StaticResource SettingsCardDescription}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" MinWidth="0"
                                          AutomationProperties.Name="Show microphone"
                                          IsOn="{x:Bind ViewModel.ShowInput, Mode=TwoWay}" />
                        </Grid>
                        <Grid Style="{StaticResource SettingsCard}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8D6;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Now playing" />
                                <TextBlock Text="Show the song or video that's playing. Media keys open it too." Style="{StaticResource SettingsCardDescription}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" MinWidth="0"
                                          AutomationProperties.Name="Show now playing"
                                          IsOn="{x:Bind ViewModel.ShowMedia, Mode=TwoWay}" />
                        </Grid>
                        <Grid Style="{StaticResource SettingsCard}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE768;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="When the song changes or pauses" />
                                <TextBlock Text="Pop up for a new song, play or pause, even when you didn't press a key" Style="{StaticResource SettingsCardDescription}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" MinWidth="0"
                                          AutomationProperties.Name="Show when the song changes or pauses"
                                          IsEnabled="{x:Bind ViewModel.ShowMedia, Mode=OneWay}"
                                          IsOn="{x:Bind ViewModel.ShowOnMediaChange, Mode=TwoWay}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingsCard}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE703;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="When devices connect or disconnect" />
                                <TextBlock Text="Headphones, speakers or mics: Bluetooth, USB or wired" Style="{StaticResource SettingsCardDescription}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" MinWidth="0"
                                          AutomationProperties.Name="Show when a device connects or disconnects"
                                          IsOn="{x:Bind ViewModel.ShowOnDeviceConnect, Mode=TwoWay}" />
                        </Grid>

                        <TextBlock Text="Startup" Style="{StaticResource SettingsSection}" />
                        <Grid Style="{StaticResource SettingsCard}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7E8;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Start with Windows" />
                                <TextBlock Text="Run in the tray when you sign in" Style="{StaticResource SettingsCardDescription}" />
                                <TextBlock Text="{x:Bind ViewModel.AutostartNote, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.HasAutostartNote, Mode=OneWay}"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" MinWidth="0"
                                          AutomationProperties.Name="Start with Windows"
                                          IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="ShortcutsPage" Grid.Row="1" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="Shortcuts" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="They work in any app. To set one, select a box and press the keys." Style="{StaticResource SettingsCardDescription}" />

                        <TextBlock Text="Output" Style="{StaticResource SettingsSection}" />
                        <Grid Style="{StaticResource SettingsCard}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8AB;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Switch to next output" />
                                <TextBlock Text="Moves to the next speaker or headphones in the tray menu" Style="{StaticResource SettingsCardDescription}" />
                                <TextBlock Text="{x:Bind ViewModel.HotkeyNote, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.HasHotkeyNote, Mode=OneWay}"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <local:HotkeyRecorder Grid.Column="2" VerticalAlignment="Center"
                                                  AccessibleName="Next output shortcut"
                                                  Hotkey="{x:Bind ViewModel.CycleOutputHotkey, Mode=OneWay}"
                                                  DefaultHotkey="{x:Bind viewModels:SettingsViewModel.DefaultCycleOutputHotkey}"
                                                  Recorded="{x:Bind ViewModel.RecordCycleOutput}"
                                                  Rejected="{x:Bind ViewModel.RejectHotkey}"
                                                  RecordingChanged="{x:Bind ViewModel.Recording}" />
                        </Grid>

                        <TextBlock Text="Devices" Style="{StaticResource SettingsSection}" />
                        <TextBlock Text="One press switches to that device and connects it if it's Bluetooth."
                                   Style="{StaticResource SettingsCardDescription}" Margin="1,0,0,4" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.DeviceHotkeys}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:DeviceHotkeyRowViewModel">
                                    <Grid Style="{StaticResource SettingsCard}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="4">
                                            <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Choose a device"
                                                      AutomationProperties.Name="Device"
                                                      ItemsSource="{x:Bind Options, Mode=OneWay}"
                                                      SelectedItem="{x:Bind Selected, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="viewModels:DeviceOption">
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                                                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="2" Text="{x:Bind Status}" Style="{StaticResource SettingsCardDescription}"
                                                                       VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Text="{x:Bind Note, Mode=OneWay}" Visibility="{x:Bind HasNote, Mode=OneWay}"
                                                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <local:HotkeyRecorder Grid.Column="1" VerticalAlignment="Center"
                                                              AccessibleName="{x:Bind ShortcutName, Mode=OneWay}"
                                                              Hotkey="{x:Bind Hotkey, Mode=OneWay}"
                                                              Recorded="{x:Bind Record}"
                                                              Rejected="{x:Bind Reject}"
                                                              RecordingChanged="{x:Bind Recording}" />
                                        <Button Grid.Column="2" VerticalAlignment="Center" Click="{x:Bind Remove}"
                                                AutomationProperties.Name="Remove shortcut" ToolTipService.ToolTip="Remove shortcut">
                                            <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Margin="0,4,0,0" Click="{x:Bind ViewModel.AddDeviceHotkey}" AutomationProperties.Name="Add shortcut">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="Add shortcut" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="WheelPage" Grid.Row="1" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="Mouse wheel" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="Scroll over the taskbar to change things without opening anything."
                                   Style="{StaticResource SettingsCardDescription}" />

                        <TextBlock Text="Volume" Style="{StaticResource SettingsSection}" />
                        <Grid Style="{StaticResource SettingsCard}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE767;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Where to scroll" />
                                <TextBlock Text="The speaker icon always changes the volume: Windows does that itself."
                                           Style="{StaticResource SettingsCardDescription}" />
                                <TextBlock Text="{x:Bind ViewModel.WheelVolumeNote, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.HasWheelVolumeNote, Mode=OneWay}"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <!-- Item order = SettingsViewModel.WheelAreaOrder. -->
                            <ComboBox Grid.Column="2" MinWidth="200" VerticalAlignment="Center"
                                      AutomationProperties.Name="Where scrolling changes the volume"
                                      DropDownOpened="{x:Bind ViewModel.ClearWheelNotes}"
                                      SelectedIndex="{x:Bind ViewModel.WheelVolumeAreaIndex, Mode=TwoWay}">
                                <x:String>Anywhere on the taskbar (default)</x:String>
                                <x:String>Over the apps</x:String>
                                <x:String>Over the tray icons and clock</x:String>
                                <x:String>Nowhere</x:String>
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource SettingsCard}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE765;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Key to hold" />
                                <TextBlock Text="Only change the volume while you hold this key" Style="{StaticResource SettingsCardDescription}" />
                            </StackPanel>
                            <!-- Item order = WheelModifier. -->
                            <ComboBox Grid.Column="2" MinWidth="200" VerticalAlignment="Center"
                                      AutomationProperties.Name="Key to hold while scrolling"
                                      DropDownOpened="{x:Bind ViewModel.ClearWheelNotes}"
                                      IsEnabled="{x:Bind ViewModel.WheelVolumeOn, Mode=OneWay}"
                                      SelectedIndex="{x:Bind ViewModel.WheelVolumeModifierIndex, Mode=TwoWay}">
                                <x:String>None (default)</x:String>
                                <x:String>Ctrl</x:String>
                                <x:String>Shift</x:String>
                                <x:String>Alt</x:String>
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource SettingsCard}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE9E9;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Step" />
                                <TextBlock Text="Percent per wheel click. Volume keys use 2." Style="{StaticResource SettingsCardDescription}" />
                            </StackPanel>
                            <NumberBox Grid.Column="2" MinWidth="200" VerticalAlignment="Center"
                                       AutomationProperties.Name="Volume step (percent)"
                                       SpinButtonPlacementMode="Inline" SmallChange="1" LargeChange="2"
                                       Minimum="1" Maximum="10"
                                       IsEnabled="{x:Bind ViewModel.WheelVolumeOn, Mode=OneWay}"
                                       Value="{x:Bind ViewModel.WheelVolumeStep, Mode=TwoWay}" />
                        </Grid>

                        <TextBlock Text="Brightness" Style="{StaticResource SettingsSection}" />
                        <Grid Style="{StaticResource SettingsCard}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7F4;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Screen" />
                                <TextBlock Text="Only the built-in screen works for now. Other monitors aren't supported yet."
                                           Style="{StaticResource SettingsCardDescription}" />
                                <TextBlock Text="{x:Bind ViewModel.BrightnessScreenNote, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.HasBrightnessScreenNote, Mode=OneWay}"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                                       TextWrapping="Wrap" MaxWidth="260" IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind ViewModel.BrightnessScreen, Mode=OneWay}" />
                        </Grid>
                        <Grid Style="{StaticResource SettingsCard}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE706;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Where to scroll" />
                                <TextBlock Text="Off until you pick a place. Volume and brightness can't scroll in the same place with the same key."
                                           Style="{StaticResource SettingsCardDescription}" />
                                <TextBlock Text="{x:Bind ViewModel.WheelBrightnessNote, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.HasWheelBrightnessNote, Mode=OneWay}"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <!-- Item order = SettingsViewModel.WheelAreaOrder. -->
                            <ComboBox Grid.Column="2" MinWidth="200" VerticalAlignment="Center"
                                      AutomationProperties.Name="Where scrolling changes the brightness"
                                      DropDownOpened="{x:Bind ViewModel.ClearWheelNotes}"
                                      SelectedIndex="{x:Bind ViewModel.WheelBrightnessAreaIndex, Mode=TwoWay}">
                                <x:String>Anywhere on the taskbar</x:String>
                                <x:String>Over the apps</x:String>
                                <x:String>Over the tray icons and clock</x:String>
                                <x:String>Nowhere (default)</x:String>
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource SettingsCard}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE765;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Key to hold" />
                                <TextBlock Text="Only change the brightness while you hold this key" Style="{StaticResource SettingsCardDescription}" />
                            </StackPanel>
                            <!-- Item order = WheelModifier. -->
                            <ComboBox Grid.Column="2" MinWidth="200" VerticalAlignment="Center"
                                      AutomationProperties.Name="Key to hold while scrolling for brightness"
                                      DropDownOpened="{x:Bind ViewModel.ClearWheelNotes}"
                                      IsEnabled="{x:Bind ViewModel.WheelBrightnessOn, Mode=OneWay}"
                                      SelectedIndex="{x:Bind ViewModel.WheelBrightnessModifierIndex, Mode=TwoWay}">
                                <x:String>None</x:String>
                                <x:String>Ctrl (default)</x:String>
                                <x:String>Shift</x:String>
                                <x:String>Alt</x:String>
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource SettingsCard}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE9E9;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Step" />
                                <TextBlock Text="Percent per wheel click. It never goes below 5 %, so the screen can't go dark."
                                           Style="{StaticResource SettingsCardDescription}" />
                            </StackPanel>
                            <NumberBox Grid.Column="2" MinWidth="200" VerticalAlignment="Center"
                                       AutomationProperties.Name="Brightness step (percent)"
                                       SpinButtonPlacementMode="Inline" SmallChange="1" LargeChange="2"
                                       Minimum="1" Maximum="10"
                                       IsEnabled="{x:Bind ViewModel.WheelBrightnessOn, Mode=OneWay}"
                                       Value="{x:Bind ViewModel.WheelBrightnessStep, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="AboutPage" Grid.Row="1" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="About" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,20" />

                        <!-- The app's identity, like the top of Windows Settings > System > About. -->
                        <Grid Style="{StaticResource SettingsCard}" Padding="20" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Source="ms-appx:///Assets/app.png" Width="64" Height="64" VerticalAlignment="Center"
                                   AutomationProperties.AccessibilityView="Raw" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Daze Media OSD" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="VersionText" IsTextSelectionEnabled="True" />
                                <TextBlock Text="A volume pop-up that also shows your audio devices and what's playing"
                                           Style="{StaticResource SettingsCardDescription}" />
                            </StackPanel>
                            <Button Grid.Column="2" VerticalAlignment="Center" Click="OnCopyDetails"
                                    AutomationProperties.Name="Copy version and system details"
                                    ToolTipService.ToolTip="Copies the app version, Windows version and folder for a bug report">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon x:Name="CopyDetailsIcon" Glyph="&#xE8C8;" FontSize="14" />
                                    <TextBlock x:Name="CopyDetailsText" Text="Copy details" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Status from UpdateService (D-030); the button checks, or restarts once one is ready. -->
                        <Grid Style="{StaticResource SettingsCard}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="UpdateIcon" Glyph="&#xE895;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="UpdateTitle" Text="Updates" />
                                <TextBlock x:Name="UpdateText" Style="{StaticResource SettingsCardDescription}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="UpdateButton" Grid.Column="2" VerticalAlignment="Center" Click="OnUpdateButton" />
                        </Grid>

                        <TextBlock Text="Files" Style="{StaticResource SettingsSection}" />
                        <Grid Style="{StaticResource SettingsCard}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7B8;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="App folder" />
                                <TextBlock x:Name="AppFolderText" Style="{StaticResource SettingsCardDescription}" IsTextSelectionEnabled="True" />
                            </StackPanel>
                            <HyperlinkButton Grid.Column="2" VerticalAlignment="Center" Content="Open folder"
                                             AutomationProperties.Name="Open the app folder" Click="OnOpenAppFolder" />
                        </Grid>
                        <Grid Style="{StaticResource SettingsCard}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8B7;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Settings and logs" />
                                <TextBlock x:Name="DataFolderText" Style="{StaticResource SettingsCardDescription}" IsTextSelectionEnabled="True" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <HyperlinkButton Content="Open log" Click="OnOpenLog" />
                                <HyperlinkButton Content="Open folder" AutomationProperties.Name="Open the settings and logs folder"
                                                 Click="OnOpenDataFolder" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Help and feedback" Style="{StaticResource SettingsSection}" />
                        <Grid Style="{StaticResource SettingsCard}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xEBE8;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Report a problem" />
                                <TextBlock Text="Select Copy details, then paste them and attach the log" Style="{StaticResource SettingsCardDescription}" />
                            </StackPanel>
                            <HyperlinkButton Grid.Column="2" VerticalAlignment="Center" Content="Report on GitHub"
                                             AutomationProperties.Name="Report a problem on GitHub"
                                             NavigateUri="https://github.com/dazewell/daze-media-osd/issues/new" />
                        </Grid>
                        <Grid Style="{StaticResource SettingsCard}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE943;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Source code" />
                                <TextBlock Text="github.com/dazewell/daze-media-osd · written by AI agents" Style="{StaticResource SettingsCardDescription}" />
                            </StackPanel>
                            <HyperlinkButton Grid.Column="2" VerticalAlignment="Center" Content="Open on GitHub"
                                             NavigateUri="https://github.com/dazewell/daze-media-osd" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
