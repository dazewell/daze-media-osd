<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DazeMediaOsd.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Daze Media OSD settings">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <!-- Cards modelled on Windows Settings: icon, header + description, control on the right.
                 Own style instead of the Community Toolkit SettingsCard package (D-010). -->
            <Style x:Key="SettingsCard" TargetType="Grid">
                <Setter Property="MinHeight" Value="68" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="ColumnSpacing" Value="16" />
                <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="SettingsCardIcon" TargetType="FontIcon">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="SettingsCardDescription" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SettingsSection" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="1,24,0,4" />
            </Style>
        </Grid.Resources>

        <TitleBar x:Name="AppTitleBar" Title="Daze Media OSD" Subtitle="Settings" />

        <NavigationView x:Name="Navigation" Grid.Row="1"
                        PaneDisplayMode="Left" IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False" OpenPaneLength="200"
                        SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="OsdItem" Content="OSD" Tag="Osd" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE767;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="About" Tag="About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <ScrollViewer>
                <Grid Padding="36,8,36,36" MaxWidth="1000" HorizontalAlignment="Stretch">
                    <StackPanel x:Name="OsdPage" Spacing="4">
                        <TextBlock Text="OSD" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />
                        <InfoBar Severity="Error" Title="Settings not saved" IsClosable="False"
                                 IsOpen="{x:Bind ViewModel.HasSaveError, Mode=OneWay}"
                                 Message="{x:Bind ViewModel.SaveError, Mode=OneWay}">
                            <InfoBar.Content>
                                <TextBlock Text="Your changes apply until the app exits." Margin="0,0,0,12"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </InfoBar.Content>
                        </InfoBar>

                        <TextBlock Text="Appearance" Style="{StaticResource SettingsSection}" />
                        <Grid Style="{StaticResource SettingsCard}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7F4;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Position" />
                                <TextBlock Text="Where the OSD appears on the primary display" Style="{StaticResource SettingsCardDescription}" />
                            </StackPanel>
                            <!-- Item order = OsdPosition's order (SettingsViewModel.PositionIndex). -->
                            <ComboBox Grid.Column="2" MinWidth="160" VerticalAlignment="Center"
                                      AutomationProperties.Name="Position"
                                      SelectedIndex="{x:Bind ViewModel.PositionIndex, Mode=TwoWay}">
                                <x:String>Bottom center</x:String>
                                <x:String>Top center</x:String>
                                <x:String>Top left</x:String>
                                <x:String>Top right</x:String>
                                <x:String>Bottom left</x:String>
                                <x:String>Bottom right</x:String>
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource SettingsCard}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE916;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Hide after" />
                                <TextBlock Text="Seconds after the last change; Windows uses about 2.5" Style="{StaticResource SettingsCardDescription}" />
                            </StackPanel>
                            <NumberBox x:Name="HideAfterBox" Grid.Column="2" MinWidth="160" VerticalAlignment="Center"
                                       AutomationProperties.Name="Hide after (seconds)"
                                       SpinButtonPlacementMode="Inline" SmallChange="0.5" LargeChange="1"
                                       Value="{x:Bind ViewModel.HideAfterSeconds, Mode=TwoWay}" />
                        </Grid>

                        <TextBlock Text="Sections" Style="{StaticResource SettingsSection}" />
                        <Grid Style="{StaticResource SettingsCard}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE720;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Microphone" />
                                <TextBlock Text="Show the default input device and whether it's muted" Style="{StaticResource SettingsCardDescription}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" MinWidth="0"
                                          AutomationProperties.Name="Show microphone"
                                          IsOn="{x:Bind ViewModel.ShowInput, Mode=TwoWay}" />
                        </Grid>
                        <Grid Style="{StaticResource SettingsCard}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8D6;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Media" />
                                <TextBlock Text="Show what's playing; media keys show the OSD too" Style="{StaticResource SettingsCardDescription}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" MinWidth="0"
                                          AutomationProperties.Name="Show media"
                                          IsOn="{x:Bind ViewModel.ShowMedia, Mode=TwoWay}" />
                        </Grid>

                        <TextBlock Text="Show the OSD" Style="{StaticResource SettingsSection}" />
                        <Grid Style="{StaticResource SettingsCard}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE703;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="When a device connects or disconnects" />
                                <TextBlock Text="Any audio device: Bluetooth, USB or wired" Style="{StaticResource SettingsCardDescription}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" MinWidth="0"
                                          AutomationProperties.Name="Show when a device connects or disconnects"
                                          IsOn="{x:Bind ViewModel.ShowOnDeviceConnect, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="AboutPage" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="About" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,20" />
                        <Grid Style="{StaticResource SettingsCard}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE767;" Style="{StaticResource SettingsCardIcon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Daze Media OSD" />
                                <TextBlock x:Name="VersionText" Style="{StaticResource SettingsCardDescription}" />
                            </StackPanel>
                            <HyperlinkButton Grid.Column="2" VerticalAlignment="Center" Content="Open data folder"
                                             ToolTipService.ToolTip="Settings and logs"
                                             Click="OnOpenDataFolder" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
