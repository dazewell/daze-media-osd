<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DazeMediaOsd.App.OsdWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DazeMediaOsd">

    <!-- 4-px grid: both rows share one column layout (icon 20 / name+bar * / value 44) and a 28 row height,
         so names, bar and values line up. Minimums, not fixed sizes: rows and columns grow with the Windows
         text-size setting instead of clipping. StackPanel: a collapsed mic row adds no spacing. -->
    <StackPanel x:Name="Root" Width="340" Padding="16" Spacing="12">
        <StackPanel.Resources>
            <Style x:Key="OsdRow" TargetType="Grid">
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="ColumnSpacing" Value="12" />
            </Style>
            <Style x:Key="OsdIcon" TargetType="FontIcon">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="OsdName" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="MaxLines" Value="1" />
            </Style>
            <Style x:Key="OsdValue" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <!-- Mute swaps styles, not brushes, so ThemeResource values still follow the theme. -->
            <Style x:Key="OsdValueMuted" TargetType="TextBlock" BasedOn="{StaticResource OsdValue}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="OsdFill" TargetType="Border">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>
            <Style x:Key="OsdFillMuted" TargetType="Border" BasedOn="{StaticResource OsdFill}">
                <Setter Property="Background" Value="{ThemeResource ControlStrongFillColorDefaultBrush}" />
            </Style>
            <Style x:Key="OsdTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="MaxLines" Value="1" />
            </Style>
            <!-- Device event line (D-014): accent for a device that came, secondary for one that went. -->
            <Style x:Key="OsdEventIcon" TargetType="FontIcon" BasedOn="{StaticResource OsdIcon}">
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="OsdEventIconGone" TargetType="FontIcon" BasedOn="{StaticResource OsdIcon}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="OsdEventStatus" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="OsdEventStatusGone" TargetType="TextBlock" BasedOn="{StaticResource OsdEventStatus}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </StackPanel.Resources>

        <!-- Device event line, only on the show that announces a connect/disconnect (D-014). Same grid as
             the device rows: glyph in the icon column, status where the values are. -->
        <Grid x:Name="EventRow" Style="{StaticResource OsdRow}" Visibility="Collapsed" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" MinWidth="44" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="28" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- Hairline: the event is a header over the current state, not one more device row. -->
            <Border Grid.Row="1" Grid.ColumnSpan="3" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <FontIcon x:Name="EventIcon" Style="{StaticResource OsdEventIcon}" RenderTransformOrigin="0.5,0.5">
                <FontIcon.RenderTransform>
                    <ScaleTransform x:Name="EventIconScale" />
                </FontIcon.RenderTransform>
            </FontIcon>
            <TextBlock x:Name="EventName" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource OsdTitle}" />
            <TextBlock x:Name="EventStatus" Grid.Column="2" Style="{StaticResource OsdEventStatus}" />
        </Grid>

        <!-- Media row on top, like the native flyout. Same value column (44) so the play-state glyph lines
             up with the numbers below; the 40-DIP cover replaces the icon column. -->
        <Grid x:Name="MediaRow" ColumnSpacing="12" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" MinWidth="44" />
            </Grid.ColumnDefinitions>
            <Grid Width="40" Height="40" CornerRadius="4" VerticalAlignment="Center"
                  Background="{ThemeResource ControlStrongFillColorDisabledBrush}">
                <FontIcon x:Name="MediaPlaceholder" Glyph="&#xE8D6;" Style="{StaticResource OsdIcon}" />
                <!-- A new cover fades in on the top image over the old one (D-033). -->
                <Image x:Name="MediaThumbnail" Stretch="UniformToFill" ImageFailed="OnThumbnailFailed" />
                <Image x:Name="MediaThumbnailNext" Stretch="UniformToFill" Opacity="0" ImageFailed="OnThumbnailFailed" />
            </Grid>
            <StackPanel x:Name="MediaText" Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="MediaTitle" Style="{StaticResource OsdTitle}" />
                <TextBlock x:Name="MediaArtist" Style="{StaticResource OsdName}" />
            </StackPanel>
            <!-- Shows the state (playing/paused), not a button: the OSD is click-through. -->
            <FontIcon x:Name="MediaPlayback" Grid.Column="2" Style="{StaticResource OsdIcon}" HorizontalAlignment="Right" />
        </Grid>

        <Grid Style="{StaticResource OsdRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" MinWidth="44" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="OutputIcon" Style="{StaticResource OsdIcon}" />
            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                <TextBlock x:Name="OutputName" Style="{StaticResource OsdName}" />
                <!-- Own track + fill instead of ProgressBar: its value transition restarts on every update
                     while a key is held (jumps), and it draws a stray dot near 0 %. -->
                <Grid x:Name="OutputTrack" Height="4" CornerRadius="2"
                      Background="{ThemeResource ControlStrongFillColorDisabledBrush}">
                    <Border x:Name="OutputFill" Style="{StaticResource OsdFill}" />
                </Grid>
            </StackPanel>
            <!-- The old number rolls out on top while the new one rolls in (D-037). -->
            <Grid Grid.Column="2">
                <TextBlock x:Name="OutputPercent" Style="{StaticResource OsdValue}" />
                <TextBlock x:Name="OutputPercentOld" Style="{StaticResource OsdValue}" Opacity="0"
                           AutomationProperties.AccessibilityView="Raw" />
            </Grid>
        </Grid>

        <Grid x:Name="InputRow" Style="{StaticResource OsdRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" MinWidth="44" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="InputIcon" Style="{StaticResource OsdIcon}" />
            <TextBlock x:Name="InputName" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource OsdName}" />
            <TextBlock x:Name="InputStatus" Grid.Column="2" Style="{StaticResource OsdValue}" />
        </Grid>
    </StackPanel>
</Window>
