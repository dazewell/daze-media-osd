<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DazeMediaOsd.App.OsdWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DazeMediaOsd">

    <Grid x:Name="Root" Width="340" Padding="16,14" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="OutputIcon" FontSize="20" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                <TextBlock x:Name="OutputName" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                <ProgressBar x:Name="OutputLevel" Maximum="100" />
            </StackPanel>
            <TextBlock x:Name="OutputPercent" Grid.Column="2" MinWidth="30" TextAlignment="Right"
                       VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
        </Grid>

        <Grid x:Name="InputRow" Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="InputIcon" FontSize="20" VerticalAlignment="Center" />
            <TextBlock x:Name="InputName" Grid.Column="1" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" MaxLines="1" />
            <TextBlock x:Name="InputStatus" Grid.Column="2" MinWidth="30" TextAlignment="Right"
                       VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>
    </Grid>
</Window>
